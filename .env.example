# Backend local environment file (Spring Boot)
# Copy to `.env` and fill in real values.
# IMPORTANT: `.env` is git-ignored. Do not commit secrets.
# Format must be KEY=value (no `export`). Quotes are optional.

# Option 1 (recommended for .env): Provide JDBC URL + credentials explicitly
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DB?sslmode=require
SPRING_DATASOURCE_USERNAME=USER
SPRING_DATASOURCE_PASSWORD=PASSWORD

# Option 2: Neon/libpq style URL (auto-converted to JDBC at startup)
# Example: postgresql://<user>:<password>@<host>/<db>?sslmode=require
# SPRING_DATASOURCE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DB_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Flyway
# If you already created tables manually in Neon, enable baselining ONCE for first run:
FLYWAY_BASELINE_ON_MIGRATE=false
FLYWAY_BASELINE_VERSION=1
FLYWAY_VALIDATE_ON_MIGRATE=true

# Server
# If port 8080 is already in use, you can override it here.
server.port=8080

# JWT
# Must be >= 32 chars
JWT_SECRET=dev-only-jwt-secret-change-me-please-32-chars
JWT_ISSUER=minibank
JWT_ACCESS_TOKEN_TTL_SECONDS=86400
