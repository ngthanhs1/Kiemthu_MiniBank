					"name": "TC_API_MOB_01: Mobile Register",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 201 Created or 409 Conflict if already exists\", function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"phone\": \"0981712585\",\n    \"email\": \"test_auto@minibank.com\",\n    \"password\": \"123456\",\n    \"fullName\": \"Automation User\",\n    \"deviceId\": \"device-postman-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/mobile/auth/register",
							"host": ["{{base_url}}"],
							"path": ["api", "mobile", "auth", "register"]
						}
					}
				},
				{
					"name": "TC_API_MOB_02: Send Login OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"OTP is returned in dev-mode\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.devMode).to.be.true;",
									"    pm.expect(jsonData.otp).to.not.be.empty;",
									"    pm.collectionVariables.set(\"otp_code\", jsonData.otp);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identifier\": \"0981712585\",\n    \"password\": \"123456\",\n    \"deviceId\": \"device-postman-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/mobile/auth/login/otp/send",
							"host": ["{{base_url}}"],
							"path": ["api", "mobile", "auth", "login", "otp", "send"]
						}
					}
				},
				{
					"name": "TC_API_MOB_03: Verify Login OTP",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Access token issued\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.accessToken).to.not.be.empty;",
									"    pm.collectionVariables.set(\"user_token\", jsonData.accessToken);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"identifier\": \"0981712585\",\n    \"otpCode\": \"{{otp_code}}\",\n    \"deviceId\": \"device-postman-01\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/mobile/auth/login/verify",
							"host": ["{{base_url}}"],
							"path": ["api", "mobile", "auth", "login", "verify"]
						}
					}
				},
				{
					"name": "TC_API_MOB_04: Get My Accounts",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Status code is 200 OK\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"pm.test(\"Response is an array of accounts\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.be.an(\"array\");",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}"
							},
							{
								"key": "X-Device-Id",
								"value": "device-postman-01"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/mobile/accounts/me",
							"host": ["{{base_url}}"],
							"path": ["api", "mobile", "accounts", "me"]
						}
					}
				}
			]
		},
