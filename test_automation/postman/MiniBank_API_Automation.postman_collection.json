{
  "info": {
    "_postman_id": "minibank-automation-collection-2026",
    "name": "MiniBank API Automation Test Suite",
    "description": "Bộ kịch bản kiểm thử tự động hóa API (Postman Collection) cho dự án MiniBank Backend - Môn Kiểm định & Đánh giá phần mềm.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "admin_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "user_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "otp_code",
      "value": "123456",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admin Portal APIs",
      "item": [
        {
          "name": "TC_API_ADM_01: Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Token type is Bearer and token exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.tokenType).to.eql(\"Bearer\");",
                  "    pm.expect(jsonData.accessToken).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"admin_token\", jsonData.accessToken);",
                  "});",
                  "pm.test(\"User role contains ADMIN\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.user.roles).to.include(\"ADMIN\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"admin@gmail.com\",\n    \"password\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/admin/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "auth",
                "login"
              ]
            }
          }
        },
        {
          "name": "TC_API_ADM_02: Get Dashboard Stats",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{admin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/admin/dashboard",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "admin",
                "dashboard"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Mobile Auth & User APIs",
      "item": [
        {
          "name": "TC_API_MOB_01: Mobile Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const randPhone = '098' + Math.floor(1000000 + Math.random() * 9000000);",
                  "pm.environment.set('reg_phone', randPhone);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200/409', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 409]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"phone\": \"{{reg_phone}}\",\n    \"email\": \"auto_{{$timestamp}}@minibank.com\",\n    \"password\": \"password123\",\n    \"fullName\": \"Automation User\",\n    \"deviceId\": \"device-postman-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "auth",
                "register"
              ]
            }
          }
        },
        {
          "name": "TC_API_MOB_02: Send Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('OTP is returned in dev-mode', function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.devMode).to.eql(true);",
                  "    pm.expect(jsonData.otp).to.exist;",
                  "    pm.environment.set('otp_code', jsonData.otp);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"0981712599\",\n    \"password\": \"password123\",\n    \"deviceId\": \"device-postman-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/login/otp/send",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "auth",
                "login",
                "otp",
                "send"
              ]
            }
          }
        },
        {
          "name": "TC_API_MOB_03: Verify Login OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Access token issued\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.accessToken).to.not.be.empty;",
                  "    pm.collectionVariables.set(\"user_token\", jsonData.accessToken);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"identifier\": \"0981712599\",\n    \"otpCode\": \"{{otp_code}}\",\n    \"deviceId\": \"device-postman-01\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/mobile/auth/login/verify",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "auth",
                "login",
                "verify"
              ]
            }
          }
        },
        {
          "name": "TC_API_MOB_04: Get My Accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response is an array of accounts\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an(\"array\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              },
              {
                "key": "X-Device-Id",
                "value": "device-postman-01"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/mobile/accounts/me",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "mobile",
                "accounts",
                "me"
              ]
            }
          }
        }
      ]
    },
